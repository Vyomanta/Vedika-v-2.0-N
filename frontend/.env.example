# Copy locally to .env.local. Never commit real values.
# Backend defaults to deployment.json; set only to the matching variant.
# LMS_BACKEND=frappe
JWT_SECRET=replace_with_a_unique_random_secret_of_at_least_32_characters
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_VOICE_WS_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
# Frappe/TiDB deployment (also used only as the source for an optional catalog import)
FRAPPE_URL=
DB_HOST=
DB_PORT=4000
DB_USER=
DB_PASSWORD=
DB_NAME=test
DB_RESOURCES_NAME=pdf_resources_db
DB_SSL=true
# Native PostgreSQL/Neon deployment
DATABASE_URL=
# Explicit administrator bootstrap; never ship default passwords
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
