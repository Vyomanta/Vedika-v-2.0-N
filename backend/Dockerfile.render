FROM frappe/bench:latest

# Switch to root to install system dependencies
USER root
RUN apt-get update && apt-get install -y redis-server mariadb-client ca-certificates && rm -rf /var/lib/apt/lists/*

# Switch to frappe user
USER frappe
WORKDIR /home/frappe

# Initialize the bench during the build phase (no Redis/DB required for file prep)
RUN bench init --frappe-branch version-16 --skip-redis-config-generation frappe-bench

WORKDIR /home/frappe/frappe-bench
RUN git -C apps/frappe fetch https://github.com/frappe/frappe.git 49789a1711d4dde2be9c6888efe35651465f4b64 --depth 1 && git -C apps/frappe checkout 49789a1711d4dde2be9c6888efe35651465f4b64

# Clone and install Payments & LMS apps at build time
RUN git clone --branch version-16 https://github.com/frappe/payments.git apps/payments --depth 1 \
    && git -C apps/payments fetch origin 9e842a473a8f4ec70a9ff06a3e067d10f98d26ed --depth 1 \
    && git -C apps/payments checkout 9e842a473a8f4ec70a9ff06a3e067d10f98d26ed \
    && rm -f apps/payments/package.json \
    && ./env/bin/pip install -e ./apps/payments \
    && ./env/bin/pip cache purge

RUN git clone --branch version-16 https://github.com/frappe/lms.git apps/lms --depth 1 \
    && git -C apps/lms fetch origin 0264da45e1644dc9b937620f6220d67749cb0277 --depth 1 \
    && git -C apps/lms checkout 0264da45e1644dc9b937620f6220d67749cb0277 \
    && rm -rf apps/lms/frontend apps/lms/package.json \
    && ./env/bin/pip install -e ./apps/lms \
    && ./env/bin/pip cache purge

# Configure apps registry file
RUN printf "frappe\npayments\nlms\n" > sites/apps.txt

# Copy and execute schema patching script to clean DocTypes at build time
COPY --chown=frappe:frappe backend/patch_schemas.py /home/frappe/frappe-bench/patch_schemas.py
RUN python3 /home/frappe/frappe-bench/patch_schemas.py && rm /home/frappe/frappe-bench/patch_schemas.py

# Copy and execute statement time patching script to bypass SET STATEMENT queries
COPY --chown=frappe:frappe backend/patch_statement_time.py /home/frappe/frappe-bench/patch_statement_time.py
RUN python3 /home/frappe/frappe-bench/patch_statement_time.py && rm /home/frappe/frappe-bench/patch_statement_time.py

# TiDB exposes MySQL generation_expression, not MariaDB is_generated.
COPY --chown=frappe:frappe backend/patch_tidb_metadata.py /home/frappe/patch_tidb_metadata.py
RUN python3 /home/frappe/patch_tidb_metadata.py /home/frappe/frappe-bench/apps/frappe/frappe/database/mariadb/mysqlclient.py

# Copy and execute API patching script to add Google OAuth endpoint
COPY --chown=frappe:frappe backend/patch_api.py /home/frappe/frappe-bench/patch_api.py
RUN python3 /home/frappe/frappe-bench/patch_api.py && rm /home/frappe/frappe-bench/patch_api.py

# Remove Redis/Watch/Socketio from Procfile so they don't spawn redundantly
RUN sed -i '/redis/d' ./Procfile \
    && sed -i '/watch/d' ./Procfile \
    && sed -i '/socketio/d' ./Procfile

# Build assets during the build phase (saves runtime CPU and RAM)
RUN bench build

# Copy startup orchestration scripts as root
USER root
COPY --chown=frappe:frappe backend/dummy_server.py /home/frappe/dummy_server.py
COPY --chown=frappe:frappe backend/create_students.py /home/frappe/create_students.py
COPY --chown=frappe:frappe backend/grant_question_perm.py /home/frappe/grant_question_perm.py
COPY --chown=frappe:frappe backend/queue_worker.py /home/frappe/queue_worker.py
COPY --chown=frappe:frappe backend/database_connection.py /home/frappe/database_connection.py
COPY --chown=frappe:frappe backend/requirements.txt /home/frappe/requirements.txt
RUN /home/frappe/frappe-bench/env/bin/pip install -r /home/frappe/requirements.txt
COPY --chown=frappe:frappe backend/frappe_wsgi.py /home/frappe/frappe-bench/frappe_wsgi.py
COPY --chown=frappe:frappe backend/prepare_site.py /home/frappe/prepare_site.py
COPY --chown=frappe:frappe backend/import_legacy.py /home/frappe/import_legacy.py
COPY --chown=frappe:frappe backend/init-render-web.sh /home/frappe/init-render-web.sh
RUN chmod +x /home/frappe/init-render-web.sh

USER frappe
WORKDIR /home/frappe
EXPOSE 8000

# Run startup script
CMD ["/home/frappe/init-render-web.sh"]
